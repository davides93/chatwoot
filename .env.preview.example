# Preview stack — fully local (postgres, redis, mailhog). No prod resource is ever touched.
#
# Used by both:
#   docker-compose.preview.yaml      (production-like build, no hot-reload)
#   docker-compose.preview.dev.yaml  (hot-reload, mirrors docker-compose.yaml)
#
# Var *names* mirror the AKS/GKE helm chart in the infra repo
# (aks/prod/helm-chatwoot/values.yml) so preview behaves like prod where it matters
# (feature flags, mailer shape, storage type). Every *value* below points at a local
# container — never at prod Postgres/Redis/Storage/SMTP.
#
# Setup:
#   cp .env.preview.example .env.preview
#   # then replace SECRET_KEY_BASE below (bundle exec rake secret)

# --- Core ---
SECRET_KEY_BASE=replace_with_lengthy_secure_hex
RAILS_ENV=production
RAILS_LOG_TO_STDOUT=true
RAILS_MAX_THREADS=5
LOG_LEVEL=info
LOG_SIZE=500
FORCE_SSL=false
FRONTEND_URL=http://localhost:3100
INSTALLATION_ENV=docker

# NOTE: ENABLE_ACCOUNT_SIGNUP here has no effect — Chatwoot reads it from the DB-backed
# InstallationConfig (seeded from config/installation_config.yml), never from ENV. To get
# a logged-in admin locally, run `make preview_setup`/`preview_dev_setup` (runs
# `rails preview:seed_admin` — see lib/tasks/preview_enhancements.rake) or the Super Admin UI.
ENABLE_ACCOUNT_SIGNUP=false

# --- Postgres: local container only ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=chatwoot_preview

# --- Redis: local container only ---
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=preview

# --- Mail: caught locally by Mailhog, nothing ever sent for real ---
MAILER_SENDER_EMAIL=Chatwoot Preview <preview@chatwoot.local>
MAILER_INBOUND_EMAIL_DOMAIN=
SMTP_DOMAIN=chatwoot.local
SMTP_ADDRESS=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=
SMTP_ENABLE_STARTTLS_AUTO=false
SMTP_OPENSSL_VERIFY_MODE=none

# --- Storage: local disk (prod uses Azure Blob — values.yml ACTIVE_STORAGE_SERVICE: microsoft) ---
ACTIVE_STORAGE_SERVICE=local

# --- Third-party integrations: intentionally blank.
# Prod values live in K8s secrets (chatwoot-env-secrets / chatwoot-db-credentials) and
# are never copied here. Leaving these blank just disables the corresponding channel locally.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3100/omniauth/google_oauth2/callback
FB_APP_ID=
FB_APP_SECRET=
FB_VERIFY_TOKEN=
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_CONFIGURATION_ID=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
TWITTER_APP_ID=
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
SENTRY_DSN=
